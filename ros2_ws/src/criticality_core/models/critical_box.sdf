<?xml version="1.0"?>

<sdf version="1.9">

  <model name="critical_box">

    <static>true</static>

    <pose>2.5 2.5 1 0 0 0</pose>

    <link name="body">

      <collision name="collision">

        <geometry>
          <box>
            <size>1 1 2</size>
          </box>
        </geometry>

      </collision>

      <visual name="visual">

        <geometry>
          <box>
            <size>1 1 2</size>
          </box>
        </geometry>

        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>

      </visual>

    </link>

  </model>

</sdf>
