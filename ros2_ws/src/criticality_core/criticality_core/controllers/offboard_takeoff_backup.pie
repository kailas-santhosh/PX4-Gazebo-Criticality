
import math

import rclpy
from rclpy.node import Node

from rclpy.qos import (
    QoSProfile,
    ReliabilityPolicy,
    HistoryPolicy,
    DurabilityPolicy,
)

from px4_msgs.msg import (
    OffboardControlMode,
    TrajectorySetpoint,
    VehicleCommand,
    VehicleLocalPosition,
)

from geometry_msgs.msg import PointStamped


class OffboardTakeoff(Node):

    def __init__(self):

        super().__init__("offboard_takeoff")

        # --------------------------------------------------
        # Parameters
        # --------------------------------------------------

        self.declare_parameter("takeoff_altitude", 3.0)
        self.declare_parameter("altitude_tolerance", 0.20)
        self.declare_parameter("altitude_hold_time", 1.0)
        self.declare_parameter("target_timeout", 1.0)
        self.declare_parameter("position_timeout", 1.0)

        self.takeoff_altitude = float(
            self.get_parameter("takeoff_altitude").value
        )

        self.altitude_tolerance = float(
            self.get_parameter("altitude_tolerance").value
        )

        self.altitude_hold_time = float(
            self.get_parameter("altitude_hold_time").value
        )

        self.target_timeout = float(
            self.get_parameter("target_timeout").value
        )

        self.position_timeout = float(
            self.get_parameter("position_timeout").value
        )

        if self.takeoff_altitude <= 0.0:
            raise ValueError("Takeoff altitude must be positive.")

        if self.altitude_tolerance <= 0.0:
            raise ValueError("Altitude tolerance must be positive.")

        if self.target_timeout <= 0.0:
            raise ValueError("Target timeout must be positive.")

        if self.position_timeout <= 0.0:
            raise ValueError("Position timeout must be positive.")

        # PX4 uses NED coordinates.
        self.takeoff_z = -self.takeoff_altitude

        # --------------------------------------------------
        # QoS
        # --------------------------------------------------

        qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
        )

        # --------------------------------------------------
        # PX4 Publishers
        # --------------------------------------------------

        self.offboard_pub = self.create_publisher(
            OffboardControlMode,
            "/fmu/in/offboard_control_mode",
            qos,
        )

        self.traj_pub = self.create_publisher(
            TrajectorySetpoint,
            "/fmu/in/trajectory_setpoint",
            qos,
        )

        self.cmd_pub = self.create_publisher(
            VehicleCommand,
            "/fmu/in/vehicle_command",
            qos,
        )

        # --------------------------------------------------
        # PX4 Position Subscription
        # --------------------------------------------------

        self.pos_sub = self.create_subscription(
            VehicleLocalPosition,
            "/fmu/out/vehicle_local_position_v1",
            self.position_callback,
            qos,
        )

        # --------------------------------------------------
        # Navigation Target Subscription
        # --------------------------------------------------

        self.target_sub = self.create_subscription(
            PointStamped,
            "/navigation/target",
            self.target_callback,
            qos,
        )

        # --------------------------------------------------
        # Vehicle State
        # --------------------------------------------------

        self.current_x = 0.0
        self.current_y = 0.0
        self.current_z = 0.0

        self.position_valid = False
        self.position_received_time = None

        self.current_target = None
        self.target_received_time = None

        # --------------------------------------------------
        # Flight State Machine
        # --------------------------------------------------

        self.phase = "WAITING_FOR_DATA"

        self.counter = 0

        self.offboard_requested = False
        self.arm_requested = False

        self.takeoff_setpoint = None
        self.hold_setpoint = None

        self.altitude_reached_since = None

        # --------------------------------------------------
        # Control Timer
        # --------------------------------------------------

        self.timer = self.create_timer(
            0.1,
            self.timer_callback,
        )

        self.get_logger().info(
            "Offboard controller initialized."
        )

        self.get_logger().info(
            f"Takeoff altitude: {self.takeoff_altitude:.2f} m"
        )

        self.get_logger().info(
            f"Following altitude: {self.takeoff_altitude:.2f} m"
        )

        self.get_logger().info(
            "Waiting for valid position and navigation target."
        )

    # --------------------------------------------------
    # ROS Time
    # --------------------------------------------------

    def current_time(self):

        return (
            self.get_clock().now().nanoseconds / 1e9
        )

    # --------------------------------------------------
    # Position Callback
    # --------------------------------------------------

    def position_callback(self, msg):

        self.current_x = float(msg.x)
        self.current_y = float(msg.y)
        self.current_z = float(msg.z)

        self.position_valid = bool(
            msg.xy_valid and msg.z_valid
        )

        self.position_received_time = self.current_time()

    # --------------------------------------------------
    # Navigation Target Callback
    # --------------------------------------------------

    def target_callback(self, msg):

        if msg.header.frame_id != "px4_local_ned":

            self.get_logger().warning(
                "Ignoring target with unexpected frame: "
                f"{msg.header.frame_id}"
            )

            return

        target = [
            float(msg.point.x),
            float(msg.point.y),
            float(msg.point.z),
        ]

        if not all(math.isfinite(value) for value in target):

            self.get_logger().warning(
                "Ignoring navigation target containing invalid values."
            )

            return

        self.current_target = target
        self.target_received_time = self.current_time()

    # --------------------------------------------------
    # Data Freshness
    # --------------------------------------------------

    def position_is_fresh(self):

        if not self.position_valid:
            return False

        if self.position_received_time is None:
            return False

        age = (
            self.current_time()
            - self.position_received_time
        )

        return (
            0.0 <= age <= self.position_timeout
        )

    def target_is_fresh(self):

        if self.current_target is None:
            return False

        if self.target_received_time is None:
            return False

        age = (
            self.current_time()
            - self.target_received_time
        )

        return (
            0.0 <= age <= self.target_timeout
        )

    # --------------------------------------------------
    # Offboard Heartbeat
    # --------------------------------------------------

    def publish_offboard_mode(self):

        msg = OffboardControlMode()

        msg.position = True
        msg.velocity = False
        msg.acceleration = False
        msg.attitude = False
        msg.body_rate = False
        msg.thrust_and_torque = False
        msg.direct_actuator = False

        self.offboard_pub.publish(msg)

    # --------------------------------------------------
    # Trajectory Setpoint
    # --------------------------------------------------

    def publish_setpoint(self, target):

        if target is None:
            return

        msg = TrajectorySetpoint()

        msg.timestamp = int(
            self.get_clock().now().nanoseconds / 1000
        )

        msg.position = [
            float(target[0]),
            float(target[1]),
            float(target[2]),
        ]

        msg.yaw = 0.0

        self.traj_pub.publish(msg)

    # --------------------------------------------------
    # Arm
    # --------------------------------------------------

    def arm(self):

        msg = VehicleCommand()

        msg.command = (
            VehicleCommand.VEHICLE_CMD_COMPONENT_ARM_DISARM
        )

        msg.param1 = 1.0

        msg.target_system = 1
        msg.target_component = 1
        msg.source_system = 1
        msg.source_component = 1

        msg.from_external = True

        self.cmd_pub.publish(msg)

        self.get_logger().info("ARM command sent.")

    # --------------------------------------------------
    # Offboard Mode
    # --------------------------------------------------

    def offboard(self):

        msg = VehicleCommand()

        msg.command = VehicleCommand.VEHICLE_CMD_DO_SET_MODE

        msg.param1 = 1.0
        msg.param2 = 6.0

        msg.target_system = 1
        msg.target_component = 1
        msg.source_system = 1
        msg.source_component = 1

        msg.from_external = True

        self.cmd_pub.publish(msg)

        self.get_logger().info("OFFBOARD command sent.")

    # --------------------------------------------------
    # Start Takeoff
    # --------------------------------------------------

    def start_takeoff(self):

        self.takeoff_setpoint = [
            self.current_x,
            self.current_y,
            self.takeoff_z,
        ]

        self.phase = "PRESTREAM"
        self.counter = 0

        self.get_logger().info(
            "Initial takeoff position selected: "
            f"X={self.current_x:.2f}, "
            f"Y={self.current_y:.2f}, "
            f"Z={self.takeoff_z:.2f}"
        )

    # --------------------------------------------------
    # Takeoff Altitude Check
    # --------------------------------------------------

    def check_takeoff_altitude(self):

        if not self.position_is_fresh():
            self.altitude_reached_since = None
            return False

        altitude_error = abs(
            self.current_z - self.takeoff_z
        )

        if altitude_error <= self.altitude_tolerance:

            if self.altitude_reached_since is None:

                self.altitude_reached_since = self.current_time()

            elapsed = (
                self.current_time()
                - self.altitude_reached_since
            )

            return elapsed >= self.altitude_hold_time

        self.altitude_reached_since = None

        return False

    # --------------------------------------------------
    # Main Control Loop
    # --------------------------------------------------

    def timer_callback(self):

        # Always publish the Offboard heartbeat.
        self.publish_offboard_mode()

        # ----------------------------------------------
        # Phase 1: Wait for valid data
        # ----------------------------------------------

        if self.phase == "WAITING_FOR_DATA":

            if (
                self.position_is_fresh()
                and self.target_is_fresh()
            ):

                self.get_logger().info(
                    "Valid vehicle position and target received."
                )

                self.start_takeoff()

            return

        # ----------------------------------------------
        # Phase 2: Pre-stream takeoff setpoint
        # ----------------------------------------------

        if self.phase == "PRESTREAM":

            self.publish_setpoint(
                self.takeoff_setpoint
            )

            self.counter += 1

            if (
                self.counter == 20
                and not self.offboard_requested
            ):

                self.offboard()

                self.offboard_requested = True

            if (
                self.counter == 25
                and not self.arm_requested
            ):

                self.arm()

                self.arm_requested = True

                self.phase = "TAKEOFF"

                self.get_logger().info(
                    "Takeoff phase started."
                )

            return

        # ----------------------------------------------
        # Phase 3: Vertical takeoff
        # ----------------------------------------------

        if self.phase == "TAKEOFF":

            self.publish_setpoint(
                self.takeoff_setpoint
            )

            if self.check_takeoff_altitude():

                self.phase = "FOLLOWING"

                self.hold_setpoint = None

                self.get_logger().info(
                    "Takeoff altitude reached. "
                    "Starting moving-target following."
                )

            return

        # ----------------------------------------------
        # Phase 4: Follow moving target
        # ----------------------------------------------

        if self.phase == "FOLLOWING":

            if self.target_is_fresh():

                self.hold_setpoint = None

                self.publish_setpoint(
                    self.current_target
                )

            else:

                # Target data has become stale.
                # Capture the latest vehicle position
                # and hold it instead of following
                # an outdated target.

                self.hold_setpoint = [
                    self.current_x,
                    self.current_y,
                    self.current_z,
                ]

                self.phase = "HOLDING_TARGET_LOST"

                self.get_logger().warning(
                    "Moving target data is stale. "
                    "Switching to position hold."
                )

                self.publish_setpoint(
                    self.hold_setpoint
                )

            return

        # ----------------------------------------------
        # Phase 5: Hold while target data is unavailable
        # ----------------------------------------------

        if self.phase == "HOLDING_TARGET_LOST":

            if self.target_is_fresh():

                self.phase = "FOLLOWING"

                self.hold_setpoint = None

                self.get_logger().info(
                    "Fresh target data restored. "
                    "Resuming target following."
                )

                self.publish_setpoint(
                    self.current_target
                )

            else:

                self.publish_setpoint(
                    self.hold_setpoint
                )

            return


def main():

    rclpy.init()

    node = OffboardTakeoff()

    try:

        rclpy.spin(node)

    except KeyboardInterrupt:

        node.get_logger().warning(
            "Offboard controller interrupted. "
            "Ensure the vehicle is safely landed before stopping."
        )

    finally:

        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()

